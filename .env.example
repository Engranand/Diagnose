# Diagnose — Environment Configuration
# Copy this file to .env and adjust values for your environment.

DIAGNOSE_ENVIRONMENT=development
DIAGNOSE_DEBUG=true

# PostgreSQL
DIAGNOSE_DATABASE_URL=postgresql+asyncpg://diagnose:diagnose_dev@localhost:5432/diagnose
DIAGNOSE_DATABASE_POOL_SIZE=10
DIAGNOSE_DATABASE_MAX_OVERFLOW=5
DIAGNOSE_DATABASE_ECHO=false

# Redis
DIAGNOSE_REDIS_URL=redis://localhost:6379/0

# API
DIAGNOSE_API_V1_PREFIX=/api/v1
